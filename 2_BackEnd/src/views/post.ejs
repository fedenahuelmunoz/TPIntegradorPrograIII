<%-  include("partials/head.ejs")%>  
<%-  include("partials/header.ejs")%>   

    <!--Sector principal de nuestro sitio del Back Office-->
    <main>

        <!--Formulario para pedir obtener un producto en base a un id-->
        <section class="createProduct-container">

            <!--Especie de cabecera del formulario-->
            <div id="cabecera-formulario">
                <h3>Crear producto</h3>
            </div>
            
            <!--Formulario propiamente dicho para crear un nuevo producto-->
            <form id="createProductForm">

                <label for="categoryProd">Categoria</label>
                <select name="category" id="categoryProd" required>
                    <option value="notebook">Notebook</option>
                    <option value="cellphone">Celular</option>
                </select>

                <label for="imageProd">Imagen</label>
                <input type="text" name="image" id="imageProd" required>

                <label for="nameProd">Nombre</label>
                <input type="text" name="name" id="nameProd" required>

                <label for="priceProd">Precio</label>
                <input type="number" name="price" id="priceProd" min="1" required>

                <input type="submit" value="Crear producto">

            </form>
        </section>
        
        <!--Contenedor para los productos, en este caso, el producto cuyo id coincide con el ingresado-->
        <section id="contenedor-productos"></section>
    </main>
    <script src="/js/post.js"></script>
     
<%- include("partials/footer.ejs") %>