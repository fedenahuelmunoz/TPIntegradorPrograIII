<%-  include("partials/head.ejs")%>  
<%-  include("partials/header.ejs")%>    

<!--Sector principal de la página principal del Back Office-->
    <main>
        <!--Sector donde iran los productos de nuestro catalogo para mostrarlos-->
        <!-- JAVASCRIPT EMBEBIDO-->
        <section id="contenedor-productos">
            <% ListaProductos.forEach(producto => {%>
                <div class="card-producto">
                        <img class="card-img" src="<%=producto.image%>" alt="<%=producto.name%>">

                        <div class="card-text">

                            <h3>Id: <%=producto.id%></h3>

                            <h4><%=producto.name%></h4>

                            <h3><%=producto.category%></h3>

                            <h3>$ <%=producto.price%></h3>

                            <h3>Estado: <%=producto.active%></h3>

                        </div>
                    </div>    
               <% })%>
        </section>
    </main>


    
<%- include("partials/footer.ejs") %>