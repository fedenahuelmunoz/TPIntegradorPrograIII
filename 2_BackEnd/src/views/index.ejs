<%-  include("partials/head.ejs")%>  
<%-  include("partials/header.ejs")%>    

<!--Sector principal de la página principal del Back Office-->
    <main>
        <!--Sector donde iran los productos de nuestro catalogo para mostrarlos-->
        <!-- JAVASCRIPT EMBEBIDO-->
        <section id="contenedor-productos">
            <% ListaProductos.forEach(producto => {%>
                <%
                    let estado = "inactivo";
                    if (Number(producto.active) === 1) {
                        estado = "activo";
                    }
                %>

                <!--Le ponemos dos clases distintas a un mismo elemento HTML separando cada clase con un espacio
                Esto es lo que hacemos con cada carta que contiene un producto inactivo-->
                <div class="card-producto <%=estado%>">
                        <img class="card-img" src="<%=producto.image%>" alt="<%=producto.name%>">

                        <div class="card-text">

                            <h3>Id: <%=producto.id%></h3>

                            <h4><%=producto.name%></h4>

                            <h3><%=producto.category%></h3>

                            <h3>$ <%=producto.price%></h3>

                            <h3>Estado: <%= estado %></h3>

                        </div>
                    </div>    
               <% })%>
        </section>
    </main>


    
<%- include("partials/footer.ejs") %>